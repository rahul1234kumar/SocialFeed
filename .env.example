# Copy to .env and fill in. .env is git-ignored; this file is the committed template.
# Read by docker compose (for ${...} in docker-compose.yml) and by Spring Boot
# (spring.config.import in application.yaml).
DB_NAME=socialfeed
DB_USERNAME=socialfeed
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
DB_HOST_PORT=3307
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value-of-32-plus-chars
